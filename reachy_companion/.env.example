# OpenAI API key for the gpt-realtime-2.1 backend (D-002). Required.
OPENAI_API_KEY=

# Optional realtime model override for on-robot A/B testing (D-023).
# Defaults to "gpt-realtime-2.1-mini" for efficiency; set to "gpt-realtime-2.1" for full model.
# REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional persona override location (D-016). By default the app looks for
# "persona.md" in this same instance directory; set an absolute path here to
# read it from somewhere else. Either way a missing, malformed or empty file
# falls back to the built-in locked persona, and one INFO line at startup
# ("persona: ...") names the source actually in use.
# PERSONA_FILE="/absolute/path/to/persona.md"

# Optional realtime input transcription language.
# Defaults to "zh". Set to a backend-supported code such as "en" for English.
# REALTIME_TRANSCRIPTION_LANGUAGE="zh"

# --- voice robustness: transcription upgrade (Task 4) — OpenAI backend only; ---
# --- the Hugging Face compat backend always uses gpt-4o-transcribe and ignores these. ---
# Input transcription model. Defaults to "gpt-transcribe", which adds keyword
# biasing and a style prompt (below). Set to "gpt-4o-transcribe" or "whisper-1"
# to opt back into the legacy shape (no keywords/prompt sent). If the upgraded
# model is ever rejected by the API mid-startup, the app automatically retries
# once with the legacy gpt-4o-transcribe shape before aborting.
# REALTIME_TRANSCRIPTION_MODEL="gpt-transcribe"
# Comma-separated words/phrases the transcriber is biased toward recognizing.
# Defaults to the party-mode address names (REALTIME_PARTY_ADDRESS_NAMES
# below) so the robot's own name is transcribed reliably. Ignored on a legacy
# transcription model.
# REALTIME_TRANSCRIPTION_KEYWORDS=客廳,冷氣
# Free-text style prompt for the transcriber. Defaults to a short description
# of the conversation domain in Traditional Chinese. Ignored on a legacy
# transcription model.
# REALTIME_TRANSCRIPTION_PROMPT="與家用陪伴機器人的台灣中文對話"

# Optional turn-detection tuning for the realtime backend (D-003).
# Type: "server_vad" (default) or "semantic_vad". Unknown values warn and use server_vad.
# REALTIME_VAD_TYPE="server_vad"
#
# server_vad knobs. Any malformed value warns and falls back to the default.
# Silence before the model takes its turn, in ms. Default 800 — raised from the
# API's own 500 so Chinese mid-sentence pauses do not cut the speaker off.
# REALTIME_VAD_SILENCE_DURATION_MS=800
# Activation threshold, 0.0-1.0. Raise it in a noisy room. Default 0.5.
# REALTIME_VAD_THRESHOLD=0.5
# Audio kept from before speech was detected, in ms. Default 300.
# REALTIME_VAD_PREFIX_PADDING_MS=300
#
# semantic_vad knob: how eagerly the model takes its turn.
# One of "low", "medium", "high", "auto". Default "auto".
# REALTIME_VAD_EAGERNESS="auto"

# --- multi-person hardening (2026-08-24, T1-T3; docs/multi-person-investigation.md) ---
# --- plus voice-robustness Tasks 2-3 (2026-08-25; docs/research-realtime-voice-best-practices.md) ---
# Input noise reduction runs server-side before VAD; far_field is the right
# mode for this robot and the default. near_field for bench tests, off restores
# the pre-2026-08-24 behavior.
# REALTIME_NOISE_REDUCTION=far_field
# Start sessions in party mode (normally toggled by voice via the party_mode
# tool instead).
# REALTIME_PARTY_DEFAULT=false
# Party mode: how long speech must persist while Reachy is audible before it
# counts as a real interruption (debounced barge-in).
# REALTIME_PARTY_BARGE_CONFIRM_MS=400
# Party mode: for how long after an accepted turn unaddressed speech is still
# answered (conversation continuity window).
# REALTIME_PARTY_FOLLOWUP_S=20
# Party mode: names that count as addressing the robot (casefolded substring
# match against the transcript).
# REALTIME_PARTY_ADDRESS_NAMES=reachy,richie,ritchie,瑞奇,里奇,小瑞,瑞曲
# (Task 2) Minimum content characters (after stripping punctuation/whitespace) for a
# transcript to count as a substantive turn, on top of failing the
# backchannel lexicon (嗯/對/好/yeah/ok/...). Filters "committed" turns that
# are just acknowledgement noise.
# REALTIME_MIN_TURN_CHARS=2
# (Task 3) Prompt-hardening block appended to the session instructions: tells the model
# to call wait_for_user instead of speaking on silence/background noise/TV/side
# conversation, to ask for a repeat (once) on unclear audio instead of
# guessing, and pins the default reply language to Taiwanese Mandarin. On by
# default; set to 0/false to restore the pre-hardening prompt.
# REALTIME_PROMPT_HARDENING=true

# --- voice robustness: TTS onset amplitude ramp (Task 5) ---
# Milliseconds each spoken reply fades in from silence, linearly, before
# reaching full amplitude. Gives the robot's hardware echo canceller time to
# converge on the new reply instead of a hard onset self-triggering it into
# barge-in. 0 disables the ramp (byte-identical to the pre-Task-5 path).
# REALTIME_ONSET_RAMP_MS=120

# --- voice robustness: boot gate (Task 6) ---
# Hold turn detection OFF for the first session of a conversation until the
# startup greeting has finished coming out of the speaker. Without it the first
# "user turn" is routinely the robot hearing its own greeting (or its echo) and
# answering itself. Released when the greeting's audio has drained, or by the
# backstop timer below. Set to 0/false to restore the pre-gate startup.
# REALTIME_BOOT_GATE=true
# Seconds after the greeting is queued before the gate opens regardless — the
# backstop for a greeting that never produces a response at all. Raise it only
# if the greeting is long; the drain wait already keeps the gate closed while
# the robot is still speaking.
# REALTIME_BOOT_GATE_TIMEOUT_S=8

# --- voice robustness: party gate hardening (Task 7) ---
# Party mode's address gate accepts three ways: the robot's name, a live
# follow-up window after an accepted turn, or (this section) a person visibly
# engaged with the robot -- detected, centered, recent -- saying something
# substantive. Backchannel noise (嗯/對/好/yeah/ok/...) is always denied, even
# inside a follow-up window; control phrases (停/閉嘴/stop/...) always pass,
# checked before every other rule. Set to 0/false to disable the face signal
# entirely and require a name or an open follow-up window instead.
# REALTIME_PARTY_FACE_GATE=true
# How old a cached face reading (from the daemon's non-blocking
# get_tracked_face) may be and still count as "right now", in seconds.
# REALTIME_PARTY_FACE_FRESH_S=3.0
# How far off-center (normalized x, 0.0 = dead center, 1.0 = edge of frame) a
# detected face may be and still count as facing the robot. The daemon's
# YuNet detector only fires on near-frontal faces, so detection alone is
# already a coarse orientation proxy; this tightens it.
# REALTIME_PARTY_FACE_CENTER=0.4

# --- voice robustness: solo pause-then-decide barge-in (Task 8) ---
# Solo mode used to let the server cancel the reply on the first syllable it
# heard, so a cough, a 「嗯」 or a sentence meant for someone else silenced Reachy
# mid-word. With this on (the default) the client owns the decision: the reply
# is PAUSED -- held back, never flushed -- and then either confirmed as a real
# interruption or rolled back and resumed where it left off. Set to 0/false to
# restore the pre-Task-8 path exactly (immediate flush, server-side
# interrupt_response=true). Party mode is unaffected either way.
# REALTIME_SOLO_CLIENT_BARGE=true
# How long speech must keep going during a pause before it counts as a real
# interruption on its own, without waiting for a transcript.
# MUST be longer than REALTIME_VAD_SILENCE_DURATION_MS (800 above), or the
# rollback can never happen: the confirm timer checks whether the speech is
# still open, and the server does not report `speech_stopped` until its whole
# silence window has elapsed -- so a shorter window confirms every onset,
# including a 100 ms cough. The app logs a warning at startup if you set one.
# This costs no perceived stop latency: the pause already silences the robot at
# the onset. What the window buys is time for the transcript to decide the
# pause properly, which is the common path; this timer is the backstop for
# speech long enough to need no transcript.
# REALTIME_BARGE_CONFIRM_MS=1400
# How long a pause waits for the turn's transcript to decide it before rolling
# itself back. This is the backstop for a blip the server never transcribes;
# with it set too low a real interruption resumes for a moment before the
# transcript confirms it.
# REALTIME_BARGE_ROLLBACK_TIMEOUT_S=2.0
# How long after a confirmed barge-in a new one is suppressed. The tail of the
# reply just cancelled (and its echo) is the likeliest thing to trigger VAD in
# that window, and pausing on it would fight the user who is still talking.
# REALTIME_BARGE_COOLDOWN_MS=800

# --- Cute-robot voice filter (D-010, D-011, D-017) ---
# Chain order: pitch -> feedback comb -> AM (off) -> makeup gain -> soft knee.
# Off by default; when off the assistant audio path is byte-for-byte unchanged.
# VOICEFX_ENABLED=false
#
# Upward pitch shift in semitones, 0-12 (0 bypasses the stage entirely).
# Since D-011 the shift is duration-preserving: a WSOLA time-stretch lengthens
# the audio by 2**(semitones/12) and a resample squeezes it back, so the reply
# keeps its own pace and only the pitch moves. Costs ~35 ms of lookahead plus
# the resampler's tail, and — measured at 24 kHz, while the assistant is
# speaking — ~1-2 % of one core on a dev box but ~15 % of one core on the robot.
# The whole spectrum moves with the pitch, which is the "short vocal tract" cue
# that reads as small and cute; +3 to +7 st is the usable band.
# VOICEFX_PITCH_SEMITONES=5.0
#
# Feedback comb — the metallic "small speaker in a tin robot" resonance (D-017).
# Delay in ms; 0 turns the stage off, otherwise 0.5-20.0. Resonances land every
# rate/delay Hz, so 4.0 ms at 24 kHz is one every 250 Hz. Shorter = brighter and
# tinnier, longer = boomier.
# VOICEFX_COMB_MS=4.0
# Comb feedback g, 0.0-0.9. Sets how sharp the resonance is: 0.45 gives 8.4 dB
# of peak-to-null ripple. Higher rings more; the cap keeps it stable.
# VOICEFX_COMB_FEEDBACK=0.45
# Comb wet/dry blend, 0.0-1.0. 0 bypasses the stage.
# VOICEFX_COMB_MIX=0.35
#
# Amplitude modulation (tremolo), OFF by default. This is the stage that made
# the robot sound "full of static": at a 55 Hz carrier it sat on the
# psychoacoustic roughness peak and buzzed on every syllable. Carrier in Hz —
# either 0 (off) or 150-4000; anything in between is refused with a warning,
# because the whole 20-150 Hz band is the roughness band. Note that below a
# 0.5 mix this is tremolo, not ring modulation: the carrier is never suppressed.
# Use the comb above for robot character; reach for this only for a light
# metallic edge on top of it.
# VOICEFX_RINGMOD_HZ=0.0
# AM wet/dry blend, 0.0-1.0. 0 bypasses the stage.
# VOICEFX_RINGMOD_MIX=0.0
#
# Makeup gain in dB, -6.0 to 12.0, applied into the saturator below. It exists
# because the pitch shift thins the perceived weight of the voice. Since D-017
# the whole range is safe — the soft knee bounds the output, so more gain buys
# loudness and smooth compression instead of the crunch it used to buy. Raise it
# if the robot's speaker is too soft.
# VOICEFX_GAIN_DB=5.0
#
# Output ceiling in dBFS, -12.0 to 0.0. -1.0 is the EBU R128 true-peak
# production limit and leaves the 24 k -> 16 k downsample the headroom its
# intersample overshoot needs. Lower it to -3.0 if anything downstream still
# reports clipping.
# VOICEFX_CEILING_DBFS=-1.0
# Knee as a fraction of the ceiling, 0.1-0.99: below knee*ceiling the chain is
# exactly linear, above it the signal bends smoothly toward the ceiling and
# never reaches it. Lower = more compression, earlier.
# VOICEFX_KNEE=0.75
#
# --- Three settings blocks to paste and A/B by ear (D-017) ---
# There is deliberately no VOICEFX_PRESET: the knobs above are already
# independent and env-driven, and a preset would silently shadow them.
#
# cute robot (default) — bright, small, lightly metallic:
# VOICEFX_PITCH_SEMITONES=5.0
# VOICEFX_COMB_MS=4.0
# VOICEFX_COMB_FEEDBACK=0.45
# VOICEFX_COMB_MIX=0.35
# VOICEFX_RINGMOD_HZ=0.0
# VOICEFX_GAIN_DB=5.0
#
# more metallic — stronger tin-robot resonance plus a touch of real AM:
# VOICEFX_PITCH_SEMITONES=5.0
# VOICEFX_COMB_MS=2.0
# VOICEFX_COMB_FEEDBACK=0.55
# VOICEFX_COMB_MIX=0.50
# VOICEFX_RINGMOD_HZ=300.0
# VOICEFX_RINGMOD_MIX=0.12
# VOICEFX_GAIN_DB=5.0
#
# plain pitched voice — pitch only, no colour (isolates the pitch stage when
# something sounds wrong and you need to know which stage owns it):
# VOICEFX_PITCH_SEMITONES=5.0
# VOICEFX_COMB_MIX=0.0
# VOICEFX_RINGMOD_HZ=0.0
# VOICEFX_GAIN_DB=5.0

# --- Face memory (D-013) ---
# Kill switch. When false, no model is loaded, no warm-up thread starts, the
# wake-time check is skipped, and remember_face/who_is_this report unavailable.
# FACE_MEMORY_ENABLED=true
# One check at wake time, naming the person in the greeting. Set to 0 to keep the
# tools but drop every automatic check.
# FACE_AUTO_GREET=1
# Single monotonic budget, in ms, covering model readiness + frame capture +
# identification at wake time. Boot waits up to this long to see a familiar face
# before greeting; overrun sends the greeting unchanged, on time.
# FACE_WAKE_BUDGET_MS=4000
# How many frames that one wake check may look at, 1-5. The first recognition
# wins; every retry still lives inside FACE_WAKE_BUDGET_MS (D-015).
# FACE_WAKE_ATTEMPTS=5
# Bounded post-greeting look window, in ms, for the person who was not yet in
# frame when the greeting went out. 0 disables it.
# FACE_WAKE_EXTENDED_MS=8000
# How many remembered facts one recognition may lean on, 0-20 — both the
# personalized greeting and the `who_is_this` tool result. 0 disables the recall
# everywhere and keeps the plain greet-by-name.
# FACE_GREETING_FACTS=6
# Intra-op threads for the SFace session, 1-4. Recognition is one short burst per
# wake, so it is allowed more than one core; busy-spinning is off either way. The
# SDK's YuNet detector keeps its own one-thread session (D-015).
# FACE_ORT_INTRA_OP_THREADS=3
# Cosine threshold a match must clear, 0.0-1.0. 0.363 is OpenCV's published
# threshold for this exact model, and ours too since the alignment reproduces
# `alignCrop` (D-015). Calibrate from the scores logged by who_is_this.
# FACE_MATCH_THRESHOLD=0.363
# Lead the best match must have over the runner-up; inside it the answer is
# `ambiguous` rather than a confidently wrong name.
# FACE_MATCH_MARGIN=0.05

# --- Sleep-time engagement memory (D-027) ---
# Kill switch for the last-chat summary. When false, going to sleep writes no
# `上次聊天` fact and no summarizer call is made; nothing else changes.
# MEMORY_LAST_CHAT_ENABLED=true
# Model that writes the one-line summary per person. It runs once, after the
# visit has ended, so a small model is the right trade.
# MEMORY_LAST_CHAT_MODEL=gpt-5-mini
# Seconds the summarizer call may take before it is abandoned, 1.0-30.0. An
# overrun is silent: the visit simply leaves no last-chat fact behind.
# MEMORY_LAST_CHAT_TIMEOUT_S=8.0

# --- Notion MCP (Task 12) ---
# Remote MCP endpoint and bearer token for the Notion tool space.
NOTION_MCP_URL=
NOTION_MCP_TOKEN=

# --- Home Assistant (Task 13) ---
# Base URL of the Home Assistant instance and a long-lived access token.
HA_URL=
HA_TOKEN=
# JSON map of spoken friendly names -> HA entity ids; the ONLY entities the
# model may target (Task 13), e.g. {"客厅的灯": "light.living_room"}
HA_ENTITIES=

# --- HomeAssistant-Nova ported capabilities (D-018) ---
# Every family below is optional. With none of these set the app boots normally
# and each ported tool answers {"status":"unavailable","reason":"<KEY>"}, where
# <KEY> is the NAME of the first prerequisite it is missing -- never a value, so
# the model can say which switch to set without ever seeing what is behind it.
# Startup logs one line per family: `hanova family <name>: enabled|disabled (reason)`.

# Timezone used for calendar and task times.
HANOVA_TZ=Asia/Taipei

# --- media-cast family (play_video, show_on_tv, all nas_* casting) ---
# Reuses HA_URL / HA_TOKEN above.
# Names of the Home Assistant scripts that do the casting. There is NO default:
# these are entry names in the operator's own scripts.yaml, so an unset name
# disables the tool that needs it rather than guessing.
#   play_video       needs HANOVA_HA_SCRIPT_YOUTUBE
#   show_on_tv       needs HANOVA_HA_SCRIPT_IMAGE_URL
#   all nas_* casts  need  HANOVA_HA_SCRIPT_VIDEO_URL
HANOVA_HA_SCRIPT_YOUTUBE=
HANOVA_HA_SCRIPT_IMAGE_URL=
HANOVA_HA_SCRIPT_VIDEO_URL=
# Optional. When set it is forwarded to those scripts as `entity_id`, so one
# robot can target a specific TV in a house with several. Not required by any
# tool.
# Beware entity churn (D-022): when the TV re-registers, HA mints a new
# media_player entity (…_3, …_5) and leaves the old id `unavailable` — update
# this AND the three tv_show_* scripts' target. Never point at the Music
# Assistant speaker proxy (device_class: speaker) for the same device.
HANOVA_CAST_ENTITY=
# How long a session-starting cast (play_video / show_on_tv / play_nas_video /
# nas_play_folder) polls that entity for actual playback before answering
# tv_not_responding instead of a false "casting" (2026-08-24). Needs
# HANOVA_CAST_ENTITY; 0 disables the check. nas_skip never waits.
# HANOVA_CAST_CONFIRM_S=12.0
# LAN base URL the TV/Chromecast fetches robot-served media from. Must be the
# robot's own LAN address (reserved IP, or a name the TV resolves) -- localhost
# is meaningless to the TV. Port 7860 is the app's own settings web server.
# Required by show_on_tv and by all nas_* casting; play_video does NOT need it.
HANOVA_MEDIA_HTTP_BASE=http://<robot-lan-ip>:7860
# Optional: move the media cache off the instance directory.
# HANOVA_MEDIA_DIR=
# LRU caps on the media cache (upstream defaults).
# HANOVA_MUSIC_KEEP=12
# HANOVA_NAS_CAST_KEEP=8
# HANOVA_IMAGE_KEEP=12
# OpenAI Images model used by show_on_tv (reuses OPENAI_API_KEY).
# HANOVA_IMAGE_MODEL=gpt-image-1

# --- music (robot speaker; needs no config, only the yt-dlp + ffmpeg wheels) ---
# HANOVA_YTDLP_SEARCH_N=2
# HANOVA_YTDLP_TIMEOUT_S=20
# HANOVA_YTDLP_DOWNLOAD_TIMEOUT_S=120
# Forwarded verbatim as `--extractor-args` on every yt-dlp call. Set it when
# YouTube starts demanding a JavaScript runtime the robot does not carry
# (every result errors "not available"); `youtube:player_client=android`
# is the known-working value as of 2026-08-22.
# HANOVA_YTDLP_EXTRACTOR_ARGS=
# YouTube ids of the two gag clips (self_destruct / mad_laugh). Blank disables them.
HANOVA_SELF_DESTRUCT_YT_ID=
HANOVA_MAD_LAUGH_YT_ID=

# --- google-workspace family (calendar_*, task_*) ---
# Directory holding <account>.json. It MUST be writable: the OAuth helper
# rewrites the file whenever it refreshes the access token.
GOOGLE_CREDS_DIR=
HANOVA_GOOGLE_ACCOUNT=<google-account>@example.com
# A shared calendar id looks like an address ending in .group.calendar.google.com;
# leave blank here and paste the real one into the robot's own .env only.
HANOVA_GCAL_CALENDAR_ID=
HANOVA_GTASKS_LIST_ID=<google-tasks-list-id>
# HANOVA_CAL_DELETE_WINDOW_DAYS=14

# --- drive family (drive_list, drive_trash, drive_upload) ---
# Path to the Drive OAuth secret JSON. NOTE: that grant carries full
# https://www.googleapis.com/auth/drive scope.
HERMES_DRIVE_SECRETS=
HANOVA_DRIVE_PARENT_ID=<drive-folder-id>

# --- notion family (notion_add) --- deliberately separate from NOTION_MCP_* above.
HANOVA_NOTION_TOKEN=
HANOVA_NOTION_DATA_SOURCE_ID=<notion-data-source-id>
# HANOVA_NOTION_TITLE_PROP=Name

# --- email family (email_send) --- sends real, irreversible outbound mail.
HANOVA_SMTP_USER=<smtp-account>@example.com
HANOVA_SMTP_APP_PASSWORD=
# HANOVA_SMTP_HOST=smtp.gmail.com
# HANOVA_SMTP_PORT=465
# HANOVA_SMTP_FROM_NAME=Reachy

# --- nas family (nas_video_query, play_nas_video, nas_play_folder, nas_skip) ---
# nas_video_query needs ONLY the index file below -- it reads local JSON and
# touches no SMB. The three casting tools need everything in this block.
HANOVA_NAS_HOST=<nas-host-or-ip>
HANOVA_NAS_USER=
HANOVA_NAS_PASSWORD=
# The share and the two folders inside it. NO defaults: these are the operator's
# own NAS layout, not something this project may guess. HANOVA_NAS_SUBPATH also
# defines the only subtree an index path is allowed to resolve inside.
HANOVA_NAS_SHARE=<smb-share-name>
HANOVA_NAS_SUBPATH=<folder-with-the-originals>
HANOVA_NAS_CAST_SUBPATH=<folder-with-the-cast-ready-mp4s>
# Operator-supplied index file; lives in the instance directory on the robot.
HANOVA_NAS_INDEX_PATH=
# Stream a clip off the share while the TV plays it, instead of copying the
# whole file into the media cache first (~7 MB/s measured, so ~44 s of silence
# for a 300 MB clip). Set to 0 to fall back to stage-then-serve, which survives
# a NAS that drops connections mid-playback.
# HANOVA_NAS_STREAM=1

# --- confirmation gating and home-network probe ---
# Seconds a pending confirmation stays valid before it must be read back again.
# HANOVA_CONFIRM_TTL_S=90
# HANOVA_HOME_PROBE_TIMEOUT_S=1.5
# HANOVA_HOME_CACHE_TTL_S=30
# The operator's home network(s), comma separated, in CIDR form. This is the ONLY
# thing that can make a house-bound tool say "I am away from home": the robot's
# own address being outside every network listed here is positive evidence of
# being somewhere else. Leave it blank and the robot will never claim you are
# out of the house -- it will say it cannot tell (home_status_unknown) instead.
# A failed connection to Home Assistant is NEVER treated as absence.
HANOVA_HOME_NETWORKS=

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440
